Algoritmo "Area_Trapezio"

Var

bMaior, bMenor, h, area : real

Inicio
bMaior <- 8.0
bMenor <- 6.0
h <- 5.0

area <- ((bMaior+bMenor)/2)*h

Escreval("A base maior é: ", bMaior)
Escreval("A base menor é: ", bMenor)
Escreval("A altura é: ", h)
Escreval()
Escreval("A área é: ", area)
Fimalgoritmo